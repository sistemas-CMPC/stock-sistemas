# Pooled (app / Vercel). En Neon con pooler agregá &pgbouncer=true
DATABASE_URL="postgresql://stock:stock@localhost:5433/stock"
# Directa (migraciones Prisma). En local puede ser igual a DATABASE_URL
DIRECT_URL="postgresql://stock:stock@localhost:5433/stock"
AUTH_SECRET="change-me-in-production"
AUTH_TRUST_HOST="true"

# local = operadores con usuario/contraseña en la app (obligatorio en Vercel)
# ldap  = Active Directory (solo red interna)
AUTH_MODE=local

# Operadores (login: nsosa / nwei / ebellon / rpardo).
# En Vercel: Environment = Production, disponibles en Runtime Y Build.
# Se aplican a la tabla "User" al arrancar la app / al hacer seed.
# PASS_NSOSA=
# PASS_NWEI=
# PASS_EBELLON=
# PASS_RPARDO=
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# --- Solo si AUTH_MODE=ldap (red interna / Docker on-prem) ---
# DC01_IP=""
# DC02_IP=""
# LDAP_URL=""
# LDAP_BASE_DN=""
# LDAP_DOMAIN=""
# LDAP_GROUP=""
# LDAP_TLS_CA_FILE=""
# LDAP_BIND_USER=""
# LDAP_BIND_PASSWORD=""
# AUTH_ALLOW_LOCAL="true"
