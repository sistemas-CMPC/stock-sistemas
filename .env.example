DATABASE_URL="postgresql://stock:stock@localhost:5433/stock"
AUTH_SECRET="change-me-in-production"
AUTH_TRUST_HOST="true"

# Puerto en el host (el contenedor sigue en 3000). Default 3001 para no chocar con otras apps.
APP_PORT=3001

# Active Directory (LDAPS) — solo miembros de GG_Sistemas pueden ingresar
LDAP_URL="ldaps://SRV-DC01.cmpc.local:636,ldaps://SRV-DC02.cmpc.local:636"
LDAP_BASE_DN="DC=cmpc,DC=local"
LDAP_DOMAIN="cmpc.local"
LDAP_GROUP="GG_Sistemas"
# Opcional: DN completo si ya lo conocés (acelera y evita buscar el grupo)
# LDAP_GROUP_DN="CN=GG_Sistemas,OU=Grupos,DC=cmpc,DC=local"
LDAP_TLS_CA_FILE="./ldaps-certificados-publicos.pem"
# Solo para diagnóstico (NO usar en producción):
# LDAP_TLS_INSECURE="true"

# Emergencia / desarrollo sin AD: AUTH_ALLOW_LOCAL=true + ADMIN_*
# AUTH_ALLOW_LOCAL="true"
# ADMIN_USERNAME="admin"
# ADMIN_EMAIL="sistemas@cmpc.org.ar"
# ADMIN_PASSWORD="admin123"
# ADMIN_NAME="Operador Sistemas"
