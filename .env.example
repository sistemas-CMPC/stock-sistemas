DATABASE_URL="postgresql://stock:cambiar@localhost:5433/stock"
POSTGRES_USER="stock"
POSTGRES_PASSWORD="cambiar"
POSTGRES_DB="stock"
AUTH_SECRET="change-me-in-production"
AUTH_TRUST_HOST="true"

# Puerto en el host (el contenedor sigue en 3000). Default 3001 para no chocar con otras apps.
APP_PORT=3001

# IPs de los Domain Controllers (obligatorio en Docker para extra_hosts)
# SRV-DC01.cmpc.local = 192.168.0.11
# SRV-DC02.cmpc.local = 192.168.0.12
DC01_IP="192.168.0.11"
DC02_IP="192.168.0.12"

# Active Directory — solo LDAPS :636 con FQDN. La app aborta si hay ldap://, IP o puerto distinto.
LDAP_URL="ldaps://SRV-DC01.cmpc.local:636,ldaps://SRV-DC02.cmpc.local:636"
LDAP_BASE_DN="DC=cmpc,DC=local"
LDAP_DOMAIN="cmpc.local"
LDAP_GROUP="GG_Sistemas"
# Opcional: DN completo si ya lo conocés (acelera y evita buscar el grupo)
# LDAP_GROUP_DN="CN=GG_Sistemas,OU=Grupos,DC=cmpc,DC=local"
LDAP_TLS_CA_FILE="./ldaps-certificados-publicos.pem"
# Si el handshake TLS falla, no hay fallback a ldap://:389.
# Revisá que este PEM coincida con los certificados actuales de los DC (vencen el 23/07/2028).
# Verificación: pnpm ldap:verify

# Cuenta de solo lectura para sincronizar Personas desde AD
LDAP_BIND_USER="usuario@cmpc.local"
LDAP_BIND_PASSWORD="cambiar"
# Opcional: limitar a una OU
# LDAP_USERS_BASE_DN="OU=Usuarios,DC=cmpc,DC=local"

# Solo desarrollo (pnpm dev). En producción (NODE_ENV=production) aborta el arranque.
# AUTH_ALLOW_LOCAL="true"
# ADMIN_USERNAME="admin"
# ADMIN_EMAIL="sistemas@cmpc.org.ar"
# ADMIN_PASSWORD="admin123"
# ADMIN_NAME="Operador Sistemas"
