generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CodeType {
  BARCODE
  QR
}

enum AssetStatus {
  IN_STOCK
  ON_LOAN
  ASSIGNED
  RETIRED
}

enum MovementType {
  ALTA
  BAJA
  INGRESO
  SALIDA_PRESTAMO
  DEVOLUCION
  ASIGNACION
  FIN_ASIGNACION
  ASIGNACION_PC
  FIN_ASIGNACION_PC
}

enum PrinterEventType {
  TONER_CHANGE
  REPAIR
  SERVICE
  NOTE
}

enum TonerMovementType {
  INCOMING
  USED
  EMPTY_OUT
  ADJUST
}

model User {
  id             String          @id @default(cuid())
  username       String          @unique
  email          String?         @unique
  name           String
  /// Null cuando el usuario autentica solo vía Active Directory
  passwordHash   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  movements      Movement[]
  printerEvents  PrinterEvent[]
  tonerMovements TonerMovement[]
}

model Category {
  id           String   @id @default(cuid())
  name         String   @unique
  isBackupDisk Boolean  @default(false)
  isPrinter    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  assets       Asset[]
}

model Person {
  id           String        @id @default(cuid())
  /// sAMAccountName de AD (clave de sync); null si se cargó a mano
  username     String?       @unique
  name         String
  area         String?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  loans        Loan[]
  assignments  Assignment[]
  workstations Workstation[]
}

model Asset {
  id          String                 @id @default(cuid())
  code        String                 @unique
  codeType    CodeType
  name        String
  description String?
  status      AssetStatus            @default(IN_STOCK)
  categoryId  String
  category    Category               @relation(fields: [categoryId], references: [id])
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  backupInfo     BackupInfo?
  printerInfo    PrinterInfo?
  printerEvents  PrinterEvent[]
  tonerMovements TonerMovement[]
  loans          Loan[]
  assignments    Assignment[]
  movements      Movement[]
  pcInstalls     WorkstationComponent[]
}

model Workstation {
  id         String                 @id @default(cuid())
  name       String                 @unique
  ipAddress  String?
  notes      String?
  active     Boolean                @default(true)
  personId   String?
  person     Person?                @relation(fields: [personId], references: [id])
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  components WorkstationComponent[]
}

model WorkstationComponent {
  id            String      @id @default(cuid())
  workstationId String
  workstation   Workstation @relation(fields: [workstationId], references: [id], onDelete: Cascade)
  assetId       String
  asset         Asset       @relation(fields: [assetId], references: [id])
  installedAt   DateTime    @default(now())
  removedAt     DateTime?
  note          String?
  createdAt     DateTime    @default(now())

  @@index([assetId, removedAt])
  @@index([workstationId, removedAt])
}

model BackupInfo {
  id           String    @id @default(cuid())
  assetId      String    @unique
  asset        Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  description  String    @default("")
  lastBackupAt DateTime?
  updatedAt    DateTime  @updatedAt
}

/// Catálogo de modelos de impresora (ej. HP LaserJet Pro M404).
model PrinterModel {
  id        String               @id @default(cuid())
  name      String               @unique
  notes     String               @default("")
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  printers  PrinterInfo[]
  toners    PrinterTonerCompat[]
}

/// Datos fijos de una impresora (ubicación, IP, último toner).
model PrinterInfo {
  id             String        @id @default(cuid())
  assetId        String        @unique
  asset          Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  printerModelId String?
  printerModel   PrinterModel? @relation(fields: [printerModelId], references: [id], onDelete: SetNull)
  location       String?
  ipAddress      String?
  /// A qué equipo/área está conectada (texto libre)
  connectedTo    String?
  lastTonerAt    DateTime?
  notes          String        @default("")
  updatedAt      DateTime      @updatedAt
}

/// Historial de mantenimiento (toner, reparaciones, notas).
model PrinterEvent {
  id        String           @id @default(cuid())
  assetId   String
  asset     Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type      PrinterEventType
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  note      String?
  createdAt DateTime         @default(now())

  @@index([assetId, createdAt])
}

/// Tipo de toner (mismo código de barras = misma familia/modelo).
model TonerSku {
  id          String               @id @default(cuid())
  barcode     String               @unique
  name        String
  color       String?
  /// Alerta cuando los llenos bajan a este nivel
  minStock    Int                  @default(1)
  notes       String               @default("")
  fullQty     Int                  @default(0)
  emptyQty    Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  printers    PrinterTonerCompat[]
  movements   TonerMovement[]
}

/// Qué modelo de impresora usa qué toner.
model PrinterTonerCompat {
  id             String       @id @default(cuid())
  tonerSkuId     String
  tonerSku       TonerSku     @relation(fields: [tonerSkuId], references: [id], onDelete: Cascade)
  printerModelId String
  printerModel   PrinterModel @relation(fields: [printerModelId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([tonerSkuId, printerModelId])
  @@index([printerModelId])
}

model TonerMovement {
  id             String            @id @default(cuid())
  tonerSkuId     String
  tonerSku       TonerSku          @relation(fields: [tonerSkuId], references: [id], onDelete: Cascade)
  type           TonerMovementType
  quantity       Int               @default(1)
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  printerAssetId String?
  printerAsset   Asset?            @relation(fields: [printerAssetId], references: [id], onDelete: SetNull)
  note           String?
  createdAt      DateTime          @default(now())

  @@index([tonerSkuId, createdAt])
}

model Loan {
  id            String    @id @default(cuid())
  assetId       String
  asset         Asset     @relation(fields: [assetId], references: [id])
  personId      String
  person        Person    @relation(fields: [personId], references: [id])
  checkedOutAt  DateTime  @default(now())
  dueAt         DateTime?
  returnedAt    DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
}

model Assignment {
  id         String    @id @default(cuid())
  assetId    String
  asset      Asset     @relation(fields: [assetId], references: [id])
  personId   String
  person     Person    @relation(fields: [personId], references: [id])
  assignedAt DateTime  @default(now())
  endedAt    DateTime?
  note       String?
  createdAt  DateTime  @default(now())
}

model Movement {
  id        String       @id @default(cuid())
  type      MovementType
  assetId   String
  asset     Asset        @relation(fields: [assetId], references: [id])
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  note      String?
  createdAt DateTime     @default(now())
}

/// Servidor físico/host con VMs adentro.
model Server {
  id        String           @id @default(cuid())
  name      String           @unique
  ipAddress String?
  /// Sistema operativo (ej. Windows Server 2022, ESXi 8, Proxmox)
  os        String?
  /// Usuario con el que se entra (sin contraseña)
  username  String?
  vcpu      Int?
  /// RAM en GB
  ramGb     Int?
  /// Discos / almacenamiento (texto libre: "2×500GB SSD, 1TB HDD")
  disks     String?
  notes     String?
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  vms       VirtualMachine[]
}

/// Máquina virtual dentro de un servidor.
model VirtualMachine {
  id        String      @id @default(cuid())
  serverId  String
  server    Server      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name      String
  ipAddress String?
  os        String?
  username  String?
  vcpu      Int?
  ramGb     Int?
  disks     String?
  /// Qué corre / roles adentro (texto libre, además de servicios listados)
  contents  String?
  notes     String?
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  services  VmService[]

  @@unique([serverId, name])
  @@index([serverId])
}

/// Servicio / rol / contenedor dentro de una VM (con IP propia si aplica).
model VmService {
  id        String          @id @default(cuid())
  vmId      String
  vm        VirtualMachine  @relation(fields: [vmId], references: [id], onDelete: Cascade)
  name      String
  ipAddress String?
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([vmId])
}
